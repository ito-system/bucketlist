rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── ヘルパー関数 ──────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return request.auth.uid == uid;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isPremium(uid) {
      let data = getUserData(uid);
      return data != null && data.planType == 'premium';
    }

    function maxMembersFor(ownerId) {
      return isPremium(ownerId) ? 10 : 2;
    }

    function getListData(listId) {
      return get(/databases/$(database)/documents/lists/$(listId)).data;
    }

    function isListMember(listId) {
      return request.auth.uid in getListData(listId).memberIds;
    }

    function isListOwner(listId) {
      return request.auth.uid == getListData(listId).ownerId;
    }

    // ─── /users/{uid} ────────────────────────────────────────────────────────

    match /users/{uid} {
      allow read: if isAuthenticated() && isCurrentUser(uid);

      // 新規登録: planType は必ず 'free' で始まる
      allow create: if isAuthenticated()
        && isCurrentUser(uid)
        && request.resource.data.uid == uid
        && request.resource.data.planType == 'free'
        && request.resource.data.get('isExempt', false) == false;

      // [H-1修正] planType の変更をクライアントから完全に禁止。
      // planType は Cloud Functions (RevenueCat Webhook) 経由でのみ更新する。
      allow update: if isAuthenticated()
        && isCurrentUser(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.planType == resource.data.planType
        && request.resource.data.get('isExempt', false) == resource.data.get('isExempt', false);

      // 本人のみ自分のアカウントを削除できる
      allow delete: if isAuthenticated() && isCurrentUser(uid);

      // ─── /users/{uid}/tags/{tagId} ──────────────────────────────────────
      match /tags/{tagId} {
        // タグはリスト共有時にメンバーも参照するため認証済みユーザー全員に許可
        allow read: if isAuthenticated();

        allow create: if isAuthenticated() && isCurrentUser(uid);
        allow update: if isAuthenticated() && isCurrentUser(uid);
        allow delete: if isAuthenticated() && isCurrentUser(uid);
      }
    }

    // ─── /lists/{listId} ─────────────────────────────────────────────────────

    match /lists/{listId} {
      // メンバーのみ読み取り可
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.memberIds;

      // リスト作成（リスト数の上限は Cloud Functions の onCreate トリガーで管理）
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() >= 1
        && request.resource.data.memberIds.size() <= maxMembersFor(request.auth.uid);

      // [H-2修正] リスト更新: オーナーによる通常更新 OR 招待コード経由の参加
      allow update: if isAuthenticated() && (
        // オーナーによる通常更新（タイトル変更・メンバー追加・削除など）
        (
          resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() >= 1
          && request.resource.data.memberIds.size() <= maxMembersFor(resource.data.ownerId)
        )
        ||
        // 招待コード経由の参加: 自分を memberIds に追加するのみ許可
        (
          request.auth.uid in request.resource.data.memberIds
          && !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.title == resource.data.title
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.size() <= maxMembersFor(resource.data.ownerId)
        )
      );

      // リスト削除はオーナーのみ
      allow delete: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;

      // ─── /lists/{listId}/items/{itemId} ──────────────────────────────────

      match /items/{itemId} {
        allow read: if isAuthenticated() && isListMember(listId);

        allow create: if isAuthenticated()
          && isListMember(listId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.listId == listId;

        allow update: if isAuthenticated()
          && isListMember(listId)
          && request.resource.data.listId == resource.data.listId
          && request.resource.data.createdBy == resource.data.createdBy;

        allow delete: if isAuthenticated()
          && (resource.data.createdBy == request.auth.uid || isListOwner(listId));
      }
    }

    // ─── /invites/{code} ─────────────────────────────────────────────────────

    match /invites/{code} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && isListMember(request.resource.data.listId);

      // [M-2修正] usedBy への追加のみ許可 + 有効期限チェックをサーバー側で実施
      allow update: if isAuthenticated()
        && resource.data.expiresAt > request.time
        && resource.data.listId == request.resource.data.listId
        && resource.data.createdBy == request.resource.data.createdBy
        && resource.data.expiresAt == request.resource.data.expiresAt;

      allow delete: if false;
    }
  }
}
